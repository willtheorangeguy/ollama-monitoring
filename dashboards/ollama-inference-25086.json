{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Ollama Models & Inference",
  "uid": "ollama-inference-25086",
  "tags": [
    "ollama",
    "ai",
    "prometheus",
    "25086"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 42,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "prometheus_ds",
        "label": "Prometheus data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "job_node_exporter",
        "label": "Prometheus job: node-exporter",
        "type": "textbox",
        "query": "node-exporter",
        "hide": 0,
        "refresh": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "node-exporter",
          "value": "node-exporter"
        }
      },
      {
        "name": "job_ollama",
        "label": "Prometheus job: ollama",
        "type": "textbox",
        "query": "ollama",
        "hide": 0,
        "refresh": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "ollama",
          "value": "ollama"
        }
      },
      {
        "name": "job_ollama_inference",
        "label": "Prometheus job: ollama-inference",
        "type": "textbox",
        "query": "ollama-inference",
        "hide": 0,
        "refresh": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "ollama-inference",
          "value": "ollama-inference"
        }
      },
      {
        "name": "ollama_instance",
        "label": "Ollama instance",
        "type": "query",
        "query": {
          "query": "label_values(up{job=\"${job_ollama}\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "hide": 0,
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        },
        "query": "label_values(ollama_inventory_model_size_bytes{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"}, model)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "endpoint",
        "label": "API Endpoint",
        "type": "custom",
        "query": "/api/chat,/api/generate,/v1/chat/completions,/v1/completions",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Ollama Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_up{job=\"${job_ollama}\",instance=\"ollama\"} * on(instance) up{job=\"${job_ollama}\",instance=\"ollama\"}",
          "legendFormat": "API",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Loaded Models",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_inventory_loaded_models{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} and on(instance) ((ollama_inventory_up{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} == 1) and on(instance) (time() - ollama_inventory_collection_timestamp_seconds{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} < 90))",
          "legendFormat": "Loaded",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Loaded Model VRAM (API Reported)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_inventory_loaded_vram_bytes{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} and on(instance) ((ollama_inventory_up{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} == 1) and on(instance) (time() - ollama_inventory_collection_timestamp_seconds{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} < 90))",
          "legendFormat": "VRAM",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latest Native Decode TPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_proxy_tokens_per_second{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}",
          "legendFormat": "{{model}} {{endpoint}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Latest reported native Ollama response, not current throughput. OpenAI responses do not expose engine timing. Missing data stays absent."
    },
    {
      "id": 5,
      "title": "Latest Native Prefill TPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_proxy_prompt_tokens_per_second{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}",
          "legendFormat": "{{model}} {{endpoint}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Latest reported native Ollama response, not current throughput. OpenAI responses do not expose engine timing. Missing data stays absent."
    },
    {
      "id": 6,
      "title": "Observed Requests Since Proxy Start",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "sum(ollama_proxy_requests_total{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"})",
          "legendFormat": "Requests",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Actual observed inference attempts across selected models/endpoints; includes validation requests and failed attempts. Resets on proxy restart."
    },
    {
      "id": 7,
      "title": "Latest Native Decode / Prefill TPS History",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "tokens/sec",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_proxy_tokens_per_second{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}",
          "legendFormat": "{{model}} decode",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_proxy_prompt_tokens_per_second{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}",
          "legendFormat": "{{model}} prefill",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Latest reported native Ollama response, not current throughput. OpenAI responses do not expose engine timing. Missing data stays absent."
    },
    {
      "id": 8,
      "title": "Observed Request Duration Percentiles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "histogram_quantile(0.5, sum by(le) (rate(ollama_proxy_request_duration_seconds_bucket{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "histogram_quantile(0.95, sum by(le) (rate(ollama_proxy_request_duration_seconds_bucket{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "histogram_quantile(0.99, sum by(le) (rate(ollama_proxy_request_duration_seconds_bucket{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "End-to-end complete proxied response duration, including HTTP failures. Not engine-only time."
    },
    {
      "id": 9,
      "title": "Eval Duration p95 (decode phase)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "histogram_quantile(0.95, sum by(le,model) (rate(ollama_proxy_eval_duration_seconds_bucket{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "{{model}} p95",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Native Ollama reported engine duration only; absent for OpenAI-compatible API requests."
    },
    {
      "id": 10,
      "title": "Prompt Eval Duration p95 (prefill phase)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "histogram_quantile(0.95, sum by(le,model) (rate(ollama_proxy_prompt_eval_duration_seconds_bucket{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "{{model}} p95",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Native Ollama reported engine duration only; absent for OpenAI-compatible API requests."
    },
    {
      "id": 11,
      "title": "Reported Token Rate (All Supported APIs)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "description": "Reported tokens per wall-clock second over the rate window, NOT engine decode speed. Only explicitly supplied usage is counted.",
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "sum by(model) (rate(ollama_proxy_prompt_tokens_total{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval]))",
          "legendFormat": "{{model}} prompt",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "sum by(model) (rate(ollama_proxy_generated_tokens_total{job=\"${job_ollama_inference}\",instance=\"ollama\",model=~\"$model\",endpoint=~\"$endpoint\"}[$__rate_interval]))",
          "legendFormat": "{{model}} generated",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "title": "Observed Model Transitions Since Poller Start",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 6
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "expr": "ollama_model_load_events_total{job=\"${job_ollama}\",instance=\"ollama\",model=~\"$model\"} and on(hostname) ((ollama_inventory_up{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} == 1) and on(instance) (time() - ollama_inventory_collection_timestamp_seconds{job=\"${job_node_exporter}\",instance=\"$ollama_instance\"} < 90))",
          "legendFormat": "{{model}} load",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
